{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "grouping": "auto",
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "speed": 4,
    "acceleration": true
  },
  "prompt": {
    "image_preview": false
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 1
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": false
  }
}
