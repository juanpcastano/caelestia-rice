[Unit]
Description=Resynchronise NumLock after system resume
Wants=ydotool.service
After=graphical-session.target ydotool.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/caelestia-numlock-resume
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
